  <path class="l" d="M456,252 L520,252" marker-end="url(#d-mig-1-a)"/>
  <path class="l" d="M680,252 L744,252" marker-end="url(#d-mig-1-a)"/>
  <rect class="b" x="296" y="320" width="160" height="56" rx="8"/>
  <text class="t" x="376" y="348">Kafka topic</text>
  <path class="l d" d="M120,280 L120,348 L296,348" marker-end="url(#d-mig-1-a)"/>
  <text class="s" x="208" y="332" style="text-anchor:middle">fallback</text>
</svg>
