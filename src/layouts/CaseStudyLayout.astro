---
import BaseLayout from './BaseLayout.astro';
import Badge from '../components/ui/Badge.astro';
import MetricCard from '../components/ui/MetricCard.astro';
import KeyValue from '../components/ui/KeyValue.astro';
import TOC from '../components/ui/TOC.astro';
import Icon from '../components/icons/Icon.astro';
import type { CollectionEntry } from 'astro:content';
import { site } from '../data/site';

interface Props {
  entry: CollectionEntry<'caseStudies'>;
  headings: { depth: number; slug: string; text: string }[];
  prev?: CollectionEntry<'caseStudies'>;
  next?: CollectionEntry<'caseStudies'>;
}
const { entry, headings, prev, next } = Astro.props;
const d = entry.data;
const isDesign = d.status === 'System design';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: d.title,
  description: d.tagline,
  author: { '@type': 'Person', name: site.name, url: site.url },
  image: new URL(`/og/${d.slug}.png`, site.url).href,
  mainEntityOfPage: new URL(`/work/${d.slug}`, site.url).href,
};
---
<BaseLayout title={d.title} description={d.tagline} ogImage={`/og/${d.slug}.png`} type="article" jsonLd={jsonLd}>
  <article class="container cs">
    <header class="cs-head">
      <a href="/#work" class="back"><Icon name="arrow-left" size={16} /> All work</a>
      <div class="cs-badge"><Badge status={d.status} /></div>
      <h1 class="cs-title">{d.title}</h1>
      <p class="cs-tag muted">{d.tagline}</p>
      <div class="cs-kv">
        <KeyValue items={[
          { k: 'Role', v: d.role },
          { k: 'Company', v: site.employer },
          { k: 'Period', v: d.period },
          { k: 'Stack', v: d.stack.join(' · ') },
        ]} />
      </div>
      <div class="cs-metrics" style={`--n:${d.metrics.length}`}>
        {d.metrics.map((m) => <MetricCard value={m.value} label={m.label} />)}
      </div>
      {!isDesign && d.showMetricsLabel && <p class="micro faint cs-mlabel">{site.metricsLabel}</p>}
    </header>
    <div class="cs-body">
      <div class="prose"><slot /></div>
      <aside class="cs-toc"><TOC headings={headings} /></aside>
    </div>
    <nav class="cs-pn" aria-label="More case studies">
      {prev ? <a href={`/work/${prev.data.slug}`} class="pn prev"><span class="micro faint">← Previous</span><span>{prev.data.title}</span></a> : <span />}
      {next ? <a href={`/work/${next.data.slug}`} class="pn next"><span class="micro faint">Next →</span><span>{next.data.title}</span></a> : <span />}
    </nav>
    <p class="cs-all"><a href="/#work">Back to all work</a></p>
  </article>
</BaseLayout>
<style>
  .cs { padding-block: 48px 96px; }
  .back { display: inline-flex; align-items: center; gap: 6px; min-height: 44px; color: var(--text-muted); font-size: var(--fs-small); }
  .back:hover { color: var(--accent); }
  .cs-badge { margin-top: 16px; }
  .cs-title { font-size: var(--fs-h1); margin-top: 14px; }
  .cs-tag { font-size: 1.125rem; margin-top: 14px; max-width: 68ch; line-height: 1.6; }
  .cs-kv { margin-top: 28px; padding-block: 20px; border-block: 1px solid var(--border); }
  .cs-metrics { display: grid; gap: 16px; margin-top: 28px; grid-template-columns: 1fr; }
  @media (min-width: 480px) { .cs-metrics { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .cs-metrics { grid-template-columns: repeat(var(--n), 1fr); } }
  .cs-mlabel { margin-top: 12px; }
  .cs-body { display: grid; grid-template-columns: minmax(0, 1fr); gap: 48px; margin-top: 24px; }
  @media (min-width: 1024px) { .cs-body { grid-template-columns: minmax(0, 1fr) 220px; } }
  .cs-toc { display: none; }
  @media (min-width: 1024px) { .cs-toc { display: block; } }
  .cs-pn { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 72px; padding-top: 24px; border-top: 1px solid var(--border); }
  .pn { display: flex; flex-direction: column; gap: 4px; padding: 16px; border: 1px solid var(--border); border-radius: 12px; color: var(--text); font-weight: 600; }
  .pn:hover { border-color: var(--accent-border); text-decoration: none; }
  .next { text-align: right; align-items: flex-end; }
  .cs-all { margin-top: 20px; text-align: center; font-size: var(--fs-small); font-weight: 600; }
  .cs-all a { display: inline-flex; align-items: center; min-height: 44px; }
</style>
